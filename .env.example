# Copy to .env. Never commit real keys.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# postgresql://vukapay:vukapay@localhost:5432/vukapay
DATABASE_URL=postgresql://vukapay:vukapay@localhost:5432/vukapay

# test | live. Live payouts require a whitelisted static egress IP.
PAYAZA_TENANT=test
PAYAZA_BASE_URL=https://api.payaza.africa/live/
# Raw public API key. The server base64-encodes it. Do not put a Bearer token here.
PAYAZA_PUBLIC_KEY=
# Secret key is NOT base64-encoded. Used for webhook HMAC-SHA512 and optional payout signatures.
PAYAZA_SECRET_KEY=
# 6-digit transaction PIN. Sent as a string. Required only when a payout is attempted.
PAYAZA_TRANSACTION_PIN=
# Set true only after Payaza has activated signed payout requests on the account.
PAYAZA_SIGN_PAYOUTS=false

# HS256 secret for exporter/admin JWTs and buyer/agent tokens. Min 32 chars.
APP_SECRET=replace-with-a-long-random-string

# live calls the public feeds. mock runs the same quote engine on the demo USD book.
# Unset: mock outside production, live when NODE_ENV=production.
FX_MODE=mock
# FX quoting. Both defaults were probed on 2026-09-28 and return KES, UGX, and TZS.
# Frankfurter does not list these currencies (HTTP 404) and is not enabled.
FX_SOURCE_EXCHANGERATE_API=true
FX_SOURCE_FAWAZ=true
# CurrencyBeacon stays off until CURRENCYBEACON_API_KEY is set.
CURRENCYBEACON_API_KEY=
FX_MAX_SOURCE_DEVIATION_BPS=150
# 36h so a daily source can pair with an intraday source. Tighten only if both sources are intraday.
FX_MAX_RATE_AGE_SECONDS=129600
FX_QUOTE_TTL_SECONDS=900
FX_SPREAD_BPS=150
# Empty disables cross-currency trades (FX_SETTLEMENT_UNAVAILABLE).
# treasury_float enables TreasuryFloatExecutor. payaza and partner stay unimplemented.
FX_SETTLEMENT_MODE=
FX_MAX_OPEN_EXPOSURE_KES_MINOR=0

# VukaPay fee policy (our fee, not Payaza's tariff). Basis points of the KES subtotal.
FEE_BPS=150
FEE_MIN_KES_MINOR=0
FEE_MAX_KES_MINOR=0

# Risk policy owned by VukaPay. These are not Payaza's published limits.
RISK_MAX_INVOICE_KES_MINOR=50000000
RISK_FIRST_PAYOUT_KES_MINOR=20000000
RISK_MAX_PAYOUTS_PER_DAY=10
RISK_PAYOUT_COOLING_SECONDS=86400

CREDIT_MIN_RECORDS=5
CREDIT_ENABLED=false

# Notifications. Unset channels stay GATED. No console pretence.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
N8N_WEBHOOK_URL=

# S3-compatible evidence and KYC storage. Unset => uploads return CAPABILITY_GATED.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# JSON array of collection network codes you copied from Payaza (sheet or support).
# Example: [{"currency":"UGX","country":"UG","code":"...","display_name":"MTN","source":"https://..."}]
# Do not invent codes. SAFKEN is included separately because it appears in Payaza's KES sample.
PAYAZA_COLLECTION_CODES_JSON=
# Must match a mobile_money code returned by Payaza's Bank Codes API for KES. Not guessed.
PAYAZA_KES_MOMO_BANK_CODE=

PUBLIC_APP_URL=http://localhost:3000

# Safaricom Daraja sandbox. STK for Kenya shilling collections. Never commit real values.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Public URL Safaricom can reach. Defaults to RENDER_EXTERNAL_URL or PUBLIC_APP_URL + /api/webhooks/mpesa/stk
MPESA_CALLBACK_URL=
